# ==========================================
# Portfolio Portal - Environment Variables
# ==========================================
# Copy this file to .env and update values
# Usage: cp .env.example .env

# ==========================================
# 1. Portal DB (PostgreSQL 15) - 인증, 블로그, Service Registry
# ==========================================
PORTAL_DB_NAME=portal_db
PORTAL_DB_USER=postgres
PORTAL_DB_PASSWORD=postgres
PORTAL_DB_HOST=portal-db
PORTAL_DB_PORT=5432

# ==========================================
# 2. AI Benchmark DB (TimescaleDB) - AI 벤치마크 전용
# ==========================================
AI_BENCH_DB_NAME=ai_bench_db
AI_BENCH_DB_USER=postgres
AI_BENCH_DB_PASSWORD=postgres
AI_BENCH_DB_HOST=ai-bench-db
AI_BENCH_DB_PORT=5433

# ==========================================
# 3. pgAdmin Configuration (Optional)
#    docker-compose --profile tools up
# ==========================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ==========================================
# 4. Portal API Server (Spring Boot)
# ==========================================
SPRING_PROFILES_ACTIVE=dev
API_SERVER_PORT=8080

# JWT Configuration
# IMPORTANT: Generate a strong secret for production!
# Example: openssl rand -base64 64
JWT_SECRET=your-secret-key-here-minimum-256-bits-recommended-change-this-in-production
JWT_ACCESS_EXPIRATION=900000        # 15 minutes (in milliseconds)
JWT_REFRESH_EXPIRATION=604800000    # 7 days (in milliseconds)
JWT_ISSUER=portfolio-portal

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_PORTFOLIO=DEBUG
LOG_FORMAT=console                   # console (dev), json (prod)

# Sentry (Optional - Error Tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Flyway
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# OAuth2 (Optional - for social login)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_KAKAO_CLIENT_ID=your-kakao-client-id
OAUTH_KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ==========================================
# 5. AI Benchmark API Server (FastAPI)
# ==========================================
AI_API_PORT=8000
AI_API_LOG_LEVEL=INFO
AI_API_ENV=dev                       # dev | prod

# Ollama Configuration
OLLAMA_HOST=host.docker.internal:11434

# ==========================================
# 6. Frontend (Next.js)
# ==========================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/portal
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8000/api/ai
NEXT_PUBLIC_ENV=dev                  # dev | prod
# NEXT_PUBLIC_SENTRY_DSN=

# ==========================================
# 7. Nginx (API Gateway)
# ==========================================
NGINX_PORT=80
NGINX_SSL_PORT=443
# NGINX_SSL_CERTIFICATE=
# NGINX_SSL_KEY=

# ==========================================
# 8. Monitoring & Observability (Future)
# ==========================================
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100

# ==========================================
# Notes
# ==========================================
# 1. JWT_SECRET: MUST be changed in production (minimum 256 bits)
#    Generate: openssl rand -base64 64
#
# 2. Passwords: Change all default passwords in production
#
# 3. OAuth2: Register apps at:
#    - Google: https://console.cloud.google.com/
#    - GitHub: https://github.com/settings/developers
#    - Kakao: https://developers.kakao.com/
#
# 4. DB Physical Separation:
#    - portal-db (5432): Portal API 전용 (인증, 블로그, Service Registry)
#    - ai-bench-db (5433): AI Benchmark API 전용
#    - 새 서비스 추가 시 별도 DB 컨테이너 + 포트 할당
#
# 5. Profiles:
#    - Default: portal-db + ai-bench-db only
#    - Backend: docker-compose --profile backend up
#    - Frontend: docker-compose --profile frontend up
#    - Tools: docker-compose --profile tools up (includes pgAdmin)
#    - All: docker-compose --profile backend --profile frontend --profile tools up
#
# 6. Port Allocation:
#    - Portal API: 8080 | portal-db: 5432
#    - AI Bench API: 8000 | ai-bench-db: 5433
#    - Frontend: 3000
#    - Nginx: 80/443
#    - 새 서비스: 81XX / 54XX
