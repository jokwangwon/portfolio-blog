# Portfolio Portal 환경변수 — 2026-09-13
# 신규 설정 시에만 .env로 복사하세요. 기존 .env에는 비밀값이 있으므로 덮어쓰지 마세요.

# 1. 공개 주소와 Cloudflare Tunnel
PUBLIC_URL=https://gwangwon.dev
# Docker 설치 명령의 --token 뒤 긴 문자열을 입력합니다. 터널 UUID가 아닙니다.
# Cloudflare: Networking > Tunnels 또는 Zero Trust > Networks > Connectors
# 공개 경로: gwangwon.dev -> http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=
GATEWAY_PORT=80

# 2. Portal DB — 기존 볼륨의 비밀번호는 이 파일만 바꿔서는 변경되지 않습니다.
PORTAL_DB_NAME=portal_db
PORTAL_DB_USER=postgres
PORTAL_DB_PASSWORD=postgres
PORTAL_DB_PORT=5432

# 3. Portal API / JWT
# 아래 dev 값은 기본 개발용입니다. docker-compose.prod.yml이 prod로 덮어씁니다.
SPRING_PROFILES_ACTIVE=dev
API_SERVER_PORT=8080
# 생성 명령: openssl rand -base64 64 (명령의 출력 값을 저장)
JWT_SECRET=your-secret-key-here-minimum-256-bits-recommended-change-this-in-production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# 4. Frontend / 공개 Pixel Office
FRONTEND_PORT=3000
# 로컬 Next.js 개발용. 운영 Docker 빌드는 true로 고정됩니다.
NEXT_PUBLIC_PUBLIC_READ_ONLY=false
OFFICE_GITHUB_OWNER=jokwangwon
OFFICE_GITHUB_REPO=portfolio-blog
# 선택: GitHub 조회용 서버 토큰 (브라우저에 노출하지 않음)
GITHUB_TOKEN=

# 5. AI 글쓰기 지원 (FastAPI)
AI_BACKEND_PORT=8081
AI_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b
# Gemini 사용 시 지정 (현재 Compose 기본값이며 공급자 모델 지원 여부는 별도 확인)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
NOTION_API_KEY=

# 6. OAuth2 — 조회 전용 첫 공개에서는 비활성, 기존 자격증명 보존용
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# 7. AI Benchmark DB — 운영에서는 benchmark 프로필로만 시작
AI_BENCH_DB_NAME=ai_bench_db
AI_BENCH_DB_USER=postgres
AI_BENCH_DB_PASSWORD=postgres
AI_BENCH_DB_PORT=5433

# 8. pgAdmin — tools 프로필 사용 시에만 시작
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# 브라우저 API/OAuth 요청은 동일 오리진을 사용합니다. VITE_* URL 설정은 사용하지 않습니다.
# 공개 운영: docker compose -f docker-compose.yml -f docker-compose.prod.yml
#            --profile backend --profile frontend --profile gateway up -d --build
# Tunnel은 토큰과 운영 점검 완료 후 --profile deploy로 시작합니다.
